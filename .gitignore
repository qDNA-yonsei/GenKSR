# Generated datasets and experiment outputs.
# Anchor directory patterns at the root: genksr/data/, genksr/evaluation/,
# and scripts/figures/ contain reproducibility code and must remain visible.
/data/
/data_*/
/datasets/
/results/
/results_*/
/artifacts/
/evaluation/
/evaluation_*/
/figures/
/plots/
/plots_*/
/outputs/
/outputs_*/
/checkpoints/
/runs/
/wandb/

# Generated arrays, model weights, serialized results, and tables anywhere.
*.npy
*.npz
*.pkl
*.pickle
*.pt
*.pth
*.pth.tar
*.ckpt
*.safetensors
*.h5
*.hdf5
*.parquet
*.csv
*.tsv
*.zip
*.tar
*.tar.gz
*.tgz

# Rendered figures and documents; retain plotting source files.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.pdf
*.eps

# Local manuscripts, notes, notebooks, logs, and summary reports.
/paper/
/docs/
/notebook/
/notebooks/
/log/
/logs/
/summary*
/SUMMARY*
*.ipynb
.ipynb_checkpoints/
*.log
*.out
events.out.tfevents.*

